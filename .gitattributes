* text=auto eol=lf

# Windows-only files keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf

# Gradle wrapper script must stay LF
gradlew text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.jar  binary
*.bin  binary
